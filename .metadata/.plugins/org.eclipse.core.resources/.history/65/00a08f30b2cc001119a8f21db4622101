

#include "GPIO.h"
#include "fsl_gpio.h"
#include "fsl_edma.h"
#include "fsl_ctimer.h"

#define DMA_BASEADDR DMA0
#define DMA_CHANNEL   0U
#define BUFFER_LENGTH 15U
#define WORD_SIZE 4U

#define SCR_OFFSET 4U
#define DEST_OFFSET 4U

#define CTIMER_INSTANCE            CTIMER4

volatile bool g_Transfer_Done = false;


static void ctimer_match0_callback(uint32_t flags)
{

}



static ctimer_callback_t ctimer_callback_table[] = {
    ctimer_match0_callback, NULL, NULL, NULL, NULL, NULL, NULL, NULL};

AT_NONCACHEABLE_SECTION_INIT(uint32_t src_addr[BUFFER_LENGTH])  = {0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A,0x0B, 0x0C, 0x0D, 0x0E, 0x0F};
AT_NONCACHEABLE_SECTION_INIT(uint32_t dest_addr[BUFFER_LENGTH]) = {0x00, 0x00, 0x00, 0x00,0x00, 0x00, 0x00, 0x00,0x00, 0x00, 0x00, 0x00,0x00, 0x00, 0x00,};


void DMA_Callback(edma_handle_t *handle, void *userData, bool transferDone, uint32_t tcds)
{
    if (transferDone)
    {
    	g_Transfer_Done =  true;
    }
}


int main(void) {

	edma_config_t cfg;
	edma_handle_t g_DMA_Handle;

	edma_transfer_config_t transferConfig;


	/*****************************DMA MUX Config **************************************************/
	/**********************************************************************************************/
	/**********************************************************************************************/
	/**********************************************************************************************/
	uint32_t ctimer_frec = 0;

	ctimer_config_t ctimerConfig;
	ctimer_match_config_t ctimerMatchConfig;

	CTIMER_GetDefaultConfig(&ctimerConfig);
	CTIMER_Init(CTIMER_INSTANCE, &ctimerConfig);

	ctimerMatchConfig.enableCounterReset = true;
	ctimerMatchConfig.enableInterrupt    = true;
	ctimerMatchConfig.enableCounterStop  = false;
	ctimerMatchConfig.matchValue         = 0U;
	ctimerMatchConfig.outControl         = kCTIMER_Output_NoAction;
	ctimerMatchConfig.outPinInitState    = false;

	CTIMER_SetupMatch(CTIMER_INSTANCE, kCTIMER_Match_0, &ctimerMatchConfig);

	CTIMER_RegisterCallBack(CTIMER_INSTANCE, &ctimer_callback_table[0U], kCTIMER_SingleCallback);

	ctimerMatchConfig.matchValue = 200;
	ctimer_frec = CLOCK_GetCTimerClkFreq(4U);
	CTIMER_SetupMatch(CTIMER_INSTANCE, kCTIMER_Match_0, &ctimerMatchConfig);
	CTIMER_StartTimer(CTIMER_INSTANCE);






    /*****************************DMA MUX Config **************************************************/
    /**********************************************************************************************/
    /**********************************************************************************************/
    /**********************************************************************************************/
	 EDMA_GetDefaultConfig(&cfg);
	 EDMA_Init(DMA_BASEADDR, &cfg);

	 EDMA_CreateHandle(&g_DMA_Handle, DMA_BASEADDR, DMA_CHANNEL);
	 EDMA_SetCallback(&g_DMA_Handle, DMA_Callback, NULL);
     EDMA_SetChannelMux(DMA_BASEADDR, DMA_CHANNEL, kDma0RequestMuxGpio0PinEventRequest0);
     /**********************************************************************************************/

     /**Always first performe a reset**************************************************************/
	 EDMA_ResetChannel(DMA_BASEADDR, DMA_CHANNEL);


	 /*****************************DMA Channel Configuration *****************************************/
	 /**********************************************************************************************/
	 /**********************************************************************************************/
	 /**********************************************************************************************/

	  memset(&transferConfig, 0, sizeof(transferConfig));

	  transferConfig.srcAddr              = (uint32_t)src_addr;
	  transferConfig.destAddr             = (uint32_t)dest_addr;
	  transferConfig.srcTransferSize      = kEDMA_TransferSize4Bytes;
	  transferConfig.destTransferSize     = kEDMA_TransferSize4Bytes;
	  transferConfig.srcOffset            = SCR_OFFSET;
	  transferConfig.destOffset           = DEST_OFFSET;
	  transferConfig.minorLoopBytes       = WORD_SIZE;
	  transferConfig.majorLoopCounts      = BUFFER_LENGTH;// number of minor loop in a mejor loop
	  transferConfig.srcAddrModulo        = kEDMA_ModuloDisable;
	  transferConfig.srcMajorLoopOffset   = -WORD_SIZE*BUFFER_LENGTH;
	  transferConfig.dstAddrModulo        = kEDMA_ModuloDisable;
	  transferConfig.dstMajorLoopOffset   = -WORD_SIZE*BUFFER_LENGTH;
	  transferConfig.enabledInterruptMask = kEDMA_MajorInterruptEnable;

	  EDMA_SubmitTransfer(&g_DMA_Handle, &transferConfig);

	  /**************************It needed for multiple cycles of tranfer *******************************/
#if defined(DMA_CSR_DREQ_MASK)
	  EDMA_TCD_CSR(EDMA_TCD_BASE(DMA_BASEADDR, DMA_CHANNEL),
				   EDMA_TCD_TYPE(DMA_BASEADDR)) &=
		  (uint16_t)~DMA_CSR_DREQ_MASK;
 #else
	  /* Fallback directo (si tu SDK no expone la macro anterior) */
	  DMA0->CH[DMA_WAVE_CHANNEL].TCD_CSR &= ~(1U << 3); /* bit DREQ = 0 */
 #endif

	  /******************************Start DMA***********************************************************/
	  EDMA_StartTransfer(&g_DMA_Handle);

    while(1) {

    }
    return 0 ;
}
